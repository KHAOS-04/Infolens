{
  "manifest_version": 3,
  "name": "Infolens",
  "version": "0.3.0",
  "description": "Shows credibility indicators for content you select on a web page.",
  "icons": {
    "16": "icons/black-16.png",
    "32": "icons/black-32.png",
    "48": "icons/black-48.png",
    "128": "icons/black-128.png"
  },
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
